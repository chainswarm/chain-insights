{
  "name": "chain-insights",
  "version": "0.8.11",
  "description": "AML investigation CLI and MCP proxy for blockchain risk, fund-flow tracing, workspace reports, and Chain Insights Graph access",
  "homepage": "https://chain-insights.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chainswarm/chain-insights.git"
  },
  "bugs": {
    "url": "https://github.com/chainswarm/chain-insights/issues"
  },
  "keywords": [
    "aml",
    "blockchain",
    "crypto-compliance",
    "chain-insights",
    "chain-insights-graph",
    "mcp",
    "x402",
    "fund-flow",
    "risk-scoring",
    "investigations"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "chain-insights": "./bin/cli.js",
    "cia": "./bin/cli.js",
    "chain-insights-mcp-proxy": "./bin/mcp-proxy.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "!skills/rbmk-*",
    "docs/*.md",
    "docs/images"
  ],
  "scripts": {
    "build": "tsdown && cp -r src/viz/templates dist/templates && mkdir -p dist/assets && cp -r src/wallet/mcp-proxy/assets/* dist/assets/",
    "dev": "tsx src/cli.ts",
    "devkit:smoke": "bash devkit/scripts/smoke.sh",
    "devkit:smoke:parity": "bash devkit/scripts/smoke-chain-insights-parity.sh",
    "release:check": "node scripts/check-release-gate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@x402/evm": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "commander": "^14.0.3",
    "hono": "^4.12.27",
    "open": "^11.0.0",
    "viem": "^2.53.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
