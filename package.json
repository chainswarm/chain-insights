{
  "name": "chain-insights",
  "version": "0.56.1",
  "description": "AML investigation CLI and MCP proxy for blockchain risk screening and Chain Insights Graph access",
  "homepage": "https://chain-insights.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chainswarm/chain-insights.git"
  },
  "bugs": {
    "url": "https://github.com/chainswarm/chain-insights/issues"
  },
  "keywords": [
    "aml",
    "blockchain",
    "crypto-compliance",
    "chain-insights",
    "chain-insights-graph",
    "mcp",
    "x402",
    "fund-flow",
    "risk-scoring",
    "investigations"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "chain-insights": "./bin/cli.js",
    "cia": "./bin/cli.js",
    "chain-insights-mcp-proxy": "./bin/mcp-proxy.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "!skills/rbmk-*",
    "docs/*.md",
    "docs/images"
  ],
  "scripts": {
    "build": "tsdown && mkdir -p dist/assets dist/apps && cp -r src/wallet/mcp-proxy/assets/* dist/assets/ && cp src/mcp/apps/claude-view.html dist/apps/",
    "dev": "tsx src/cli.ts",
    "corpus:generate": "tsx scripts/generate-query-corpus.mjs",
    "release:check": "node scripts/check-release-gate.mjs",
    "lint:package": "publint",
    "check:types-resolution": "attw --pack .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "lint": "oxlint src tests",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "commander": "^14.0.3",
    "open": "^11.0.0",
    "viem": "^2.57.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsqr": "1.4.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.0.0",
    "publint": "^0.3.23",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "ws": "8.21.0",
    "proxy-addr": "2.0.8"
  }
}
