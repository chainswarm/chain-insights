{
  "name": "chain-insights",
  "version": "0.1.0",
  "description": "AML investigation toolkit for blockchain analysis",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "chain-insights": "./bin/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": ">=1.5.0-r.1",
    "@hono/node-server": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@x402/evm": "^2.11.0",
    "@x402/fetch": "^2.11.0",
    "commander": "^14.0.3",
    "hono": "^4.12.18",
    "viem": "^2.48.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
