{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/../AP1000/scripts/agent-hook.py\" repo-session",
            "timeout": 20,
            "statusMessage": "Checking the clone against origin/main"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/../AP1000/scripts/agent-hook.py\" guard",
            "timeout": 5,
            "statusMessage": "Checking permanent-data safety"
          }
        ]
      }
    ]
  }
}
