@startuml
title <size:24>Component View: Chain Insights Toolkit - cia CLI</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(DataPipelineGraphRAGMCP, "Data Pipeline GraphRAG MCP", $descr="Public MCP endpoint serving graph queries, risk tools, quota, and report metadata.", $tags="", $link="")

System_Boundary("ChainInsightsToolkit_boundary", "Chain Insights Toolkit", $tags="") {
  Container_Boundary("ChainInsightsToolkit.ciaCLI_boundary", "cia CLI", $tags="") {
    Component(ChainInsightsToolkit.ciaCLI.AMLWorkflowCommands, "AML Workflow Commands", $techn="src/investigation", $descr="Runs address risk and graph query workflows.", $tags="", $link="")
    Component(ChainInsightsToolkit.ciaCLI.CaseManager, "Case Manager", $techn="src/cases", $descr="Creates, resumes, verifies, and updates local case evidence manifests.", $tags="", $link="")
    Component(ChainInsightsToolkit.ciaCLI.AgentInstaller, "Agent Installer", $techn="src/install", $descr="Installs MCP proxy configuration for local agent clients.", $tags="", $link="")
    Component(ChainInsightsToolkit.ciaCLI.ConfigResolver, "Config Resolver", $techn="src/config", $descr="Resolves graphMcpEndpoint, auth token, workspace paths, and hosted/local endpoint precedence.", $tags="", $link="")
    Component(ChainInsightsToolkit.ciaCLI.GraphMCPClient, "Graph MCP Client", $techn="src/mcp", $descr="Calls GraphRAG MCP tools and refreshes tool catalogues.", $tags="", $link="")
  }

  Container(ChainInsightsToolkit.LocalWorkspaceStore, "Local Workspace Store", $techn="Files", $descr="Filesystem workspace containing cases, evidence manifests, dossiers, and config.", $tags="", $link="")
}

Rel(ChainInsightsToolkit.ciaCLI.ConfigResolver, ChainInsightsToolkit.ciaCLI.GraphMCPClient, "Provides endpoint and auth config", $techn="", $tags="", $link="")
Rel(ChainInsightsToolkit.ciaCLI.GraphMCPClient, DataPipelineGraphRAGMCP, "Calls public MCP tools", $techn="", $tags="", $link="")
Rel(ChainInsightsToolkit.ciaCLI.AMLWorkflowCommands, ChainInsightsToolkit.ciaCLI.GraphMCPClient, "Composes graph tool calls", $techn="", $tags="", $link="")
Rel(ChainInsightsToolkit.ciaCLI.AMLWorkflowCommands, ChainInsightsToolkit.ciaCLI.CaseManager, "Stores compact evidence pointers", $techn="", $tags="", $link="")
Rel(ChainInsightsToolkit.ciaCLI.CaseManager, ChainInsightsToolkit.LocalWorkspaceStore, "Writes manifests, dossiers, and sessions", $techn="", $tags="", $link="")
Rel(ChainInsightsToolkit.ciaCLI.AgentInstaller, ChainInsightsToolkit.LocalWorkspaceStore, "Writes client proxy configuration", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml