 "queries": {
  "token": "USE topology MATCH (t:Address {address:'$ADDR'})<-[c:DEPLOYED_CONTRACT]-(:Address) WITH t, c ORDER BY c.block_height LIMIT 1 MATCH (l:Address {address: c.tx_origin}) OPTIONAL MATCH (f:Address)-[e:FLOWED_TO]->(l) WITH t, c, l, f, e ORDER BY e.first_seen_timestamp LIMIT 1 OPTIONAL MATCH (ch:Chain)-[b:BRIDGED]->(l) WHERE b.kind IN ['TOKEN_DEPOSIT','NATIVE_DEPOSIT'] WITH t, c, l, f, e, ch, b ORDER BY b.first_height LIMIT 1 RETURN t.address AS token, labels(t) AS token_roles, c.tx_origin AS launcher, c.deployer_address AS deployer, c.factory_address AS factory, c.kind AS creation_kind, c.tx_id AS creation_tx, c.block_height AS creation_block, c.block_timestamp AS creation_time, labels(l) AS launcher_roles, l.first_activity_timestamp AS launcher_first_activity, l.degree_in AS launcher_degree_in, l.degree_out AS launcher_degree_out, l.is_sanctioned AS launcher_is_sanctioned, l.is_scam AS launcher_is_scam, l.is_victim AS launcher_is_victim, l.is_issuer_frozen AS launcher_is_issuer_frozen, l.label_risk_labels AS launcher_risk_labels, l.label_risk_levels AS launcher_risk_levels, f.address AS funder, labels(f) AS funder_roles, f.degree_out AS funder_degree_out, f.first_activity_timestamp AS funder_first_activity, f.is_sanctioned AS funder_is_sanctioned, f.is_scam AS funder_is_scam, f.is_victim AS funder_is_victim, f.is_issuer_frozen AS funder_is_issuer_frozen, f.label_risk_labels AS funder_risk_labels, f.label_risk_levels AS funder_risk_levels, e.first_seen_timestamp AS funded_at, e.tx_count AS funding_tx_count, e.amount_usd_sum AS funding_usd, ch.network AS bridged_chain, ch.address AS bridged_bridge, b.kind AS bridged_kind, b.asset AS bridged_asset, b.first_height AS bridged_first_block LIMIT 1",
  "wallet": "USE topology MATCH (l:Address {address:'$ADDR'}) OPTIONAL MATCH (f:Address)-[e:FLOWED_TO]->(l) WITH l, f, e ORDER BY e.first_seen_timestamp LIMIT 1 OPTIONAL MATCH (ch:Chain)-[b:BRIDGED]->(l) WHERE b.kind IN ['TOKEN_DEPOSIT','NATIVE_DEPOSIT'] WITH l, f, e, ch, b ORDER BY b.first_height LIMIT 1 RETURN l.address AS launcher, labels(l) AS launcher_roles, l.first_activity_timestamp AS launcher_first_activity, l.degree_in AS launcher_degree_in, l.degree_out AS launcher_degree_out, l.is_sanctioned AS launcher_is_sanctioned, l.is_scam AS launcher_is_scam, l.is_victim AS launcher_is_victim, l.is_issuer_frozen AS launcher_is_issuer_frozen, l.label_risk_labels AS launcher_risk_labels, l.label_risk_levels AS launcher_risk_levels, f.address AS funder, labels(f) AS funder_roles, f.degree_out AS funder_degree_out, f.first_activity_timestamp AS funder_first_activity, f.is_sanctioned AS funder_is_sanctioned, f.is_scam AS funder_is_scam, f.is_victim AS funder_is_victim, f.is_issuer_frozen AS funder_is_issuer_frozen, f.label_risk_labels AS funder_risk_labels, f.label_risk_levels AS funder_risk_levels, e.first_seen_timestamp AS funded_at, e.tx_count AS funding_tx_count, e.amount_usd_sum AS funding_usd, ch.network AS bridged_chain, ch.address AS bridged_bridge, b.kind AS bridged_kind, b.asset AS bridged_asset, b.first_height AS bridged_first_block LIMIT 1"
