  "reverse_deposit_sources_2: MATCH (source:Address)-[r1:FLOWS_TO]->(n1:Address)-[r2:FLOWS_TO]->(deposit:Address) WHERE (deposit.address = "deposit-a" OR deposit.address = "deposit-b") AND source.address <> deposit.address AND source.is_exchange IS NULL AND n1.is_exchange IS NULL AND deposit.is_exchange IS NULL AND r1.amount_usd_sum >= 10 AND r2.amount_usd_sum >= 10 RETURN DISTINCT source.address AS source_address, source.is_exchange AS source_is_exchange, deposit.address AS deposit_address, deposit.is_exchange AS deposit_is_exchange, 2 AS hop, [source.address, n1.address, deposit.address] AS addresses, [{address: source.address, network: source.network, labels: source.labels, system_labels: source.labels, is_exchange: source.is_exchange, risk_score: source.risk_score, risk_level: source.risk_level}, {address: n1.address, network: n1.network, labels: n1.labels, system_labels: n1.labels, is_exchange: n1.is_exchange, risk_score: n1.risk_score, risk_level: n1.risk_level}, {address: deposit.address, network: deposit.network, labels: deposit.labels, system_labels: deposit.labels, is_exchange: deposit.is_exchange, risk_score: deposit.risk_score, risk_level: deposit.risk_level}] AS path_nodes, [{amount_usd_sum: r1.amount_usd_sum, tx_count: r1.tx_count, first_seen_timestamp: r1.first_seen_timestamp, last_seen_timestamp: r1.last_seen_timestamp, first_tx_id: r1.first_tx_id, last_tx_id: r1.last_tx_id}, {amount_usd_sum: r2.amount_usd_sum, tx_count: r2.tx_count, first_seen_timestamp: r2.first_seen_timestamp, last_seen_timestamp: r2.last_seen_timestamp, first_tx_id: r2.first_tx_id, last_tx_id: r2.last_tx_id}] AS edge_props LIMIT 500",
  "reverse_deposit_sources_3: MATCH (source:Address)-[r1:FLOWS_TO]->(n1:Address)-[r2:FLOWS_TO]->(n2:Address)-[r3:FLOWS_TO]->(deposit:Address) WHERE (deposit.address = "deposit-a" OR deposit.address = "deposit-b") AND source.address <> deposit.address AND source.is_exchange IS NULL AND n1.is_exchange IS NULL AND n2.is_exchange IS NULL AND deposit.is_exchange IS NULL AND r1.amount_usd_sum >= 10 AND r2.amount_usd_sum >= 10 AND r3.amount_usd_sum >= 10 RETURN DISTINCT source.address AS source_address, source.is_exchange AS source_is_exchange, deposit.address AS deposit_address, deposit.is_exchange AS deposit_is_exchange, 3 AS hop, [source.address, n1.address, n2.address, deposit.address] AS addresses, [{address: source.address, network: source.network, labels: source.labels, system_labels: source.labels, is_exchange: source.is_exchange, risk_score: source.risk_score, risk_level: source.risk_level}, {address: n1.address, network: n1.network, labels: n1.labels, system_labels: n1.labels, is_exchange: n1.is_exchange, risk_score: n1.risk_score, risk_level: n1.risk_level}, {address: n2.address, network: n2.network, labels: n2.labels, system_labels: n2.labels, is_exchange: n2.is_exchange, risk_score: n2.risk_score, risk_level: n2.risk_level}, {address: deposit.address, network: deposit.network, labels: deposit.labels, system_labels: deposit.labels, is_exchange: deposit.is_exchange, risk_score: deposit.risk_score, risk_level: deposit.risk_level}] AS path_nodes, [{amount_usd_sum: r1.amount_usd_sum, tx_count: r1.tx_count, first_seen_timestamp: r1.first_seen_timestamp, last_seen_timestamp: r1.last_seen_timestamp, first_tx_id: r1.first_tx_id, last_tx_id: r1.last_tx_id}, {amount_usd_sum: r2.amount_usd_sum, tx_count: r2.tx_count, first_seen_timestamp: r2.first_seen_timestamp, last_seen_timestamp: r2.last_seen_timestamp, first_tx_id: r2.first_tx_id, last_tx_id: r2.last_tx_id}, {amount_usd_sum: r3.amount_usd_sum, tx_count: r3.tx_count, first_seen_timestamp: r3.first_seen_timestamp, last