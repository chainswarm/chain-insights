width="5" height="5" fill="#000" rx="0.5"/><rect x="125" y="135" width="5" height="5" fill="#000" rx="0.5"/><rect x="135" y="135" width="5" height="5" fill="#000" rx="0.5"/><rect x="0" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="5" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="10" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="15" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="20" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="25" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="30" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="40" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="45" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="50" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="60" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="85" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="90" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="100" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="110" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="120" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="125" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="135" y="140" width="5" height="5" fill="#000" rx="0.5"/><rect x="140" y="140" width="5" height="5" fill="#000" rx="0.5"/></svg></div>

    <div class="address-box">
      <code id="address">0x0000000000000000000000000000000000000001</code>
      <button class="copy-btn" onclick="copyAddress()" id="copyBtn" title="Copy address">&#x2398;</button>
    </div>

    <div class="network-badge">
      <span class="dot"></span>
      Base Network &middot; USDC
    </div>

    <div class="balance-row">
      <span class="balance-label">Current balance</span>
      <span class="balance-value" id="balance">—<span class="currency">USDC</span></span>
    </div>
    <div class="balance-row">
      <span class="balance-label">Gas balance</span>
      <span class="balance-value" id="gasBalance">—<span class="currency">ETH</span></span>
    </div>
    <p class="gas-note">Base ETH is used for one-time payment setup gas.</p>

    <div class="status" id="status"></div>
  </div>

  <p class="info">Send Base USDC to the wallet address above.</p>
</div>

<script>
const WALLET = "0x0000000000000000000000000000000000000001";
const BALANCES = [{"id":"balance","currency":"USDC","field":"balance_usdc","decimals":2},{"id":"gasBalance","currency":"ETH","field":"balance_eth","decimals":6}];

// Copy address — fallback for sandboxed iframes where navigator.clipboard is blocked
function copyAddress() {
  var ok = false;
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(WALLET).then(function() { ok = true; }).catch(function() {});
  }
  if (!ok) {
    var ta = document.createElement('textarea');
    ta.value = WALLET;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch(e) {}
    document.body.removeChild(ta);
  }
  var btn = document.getElementById('copyBtn');
  btn.classList.add('copied');
  btn.innerHTML = '&#x2713;';
  setTimeout(function() { btn.classList.remove('copied'); btn.innerHTML = '&#x2398;'; }, 2000);
}

function showBalance(row, value) {
  document.getElementById(row.id).innerHTML = value + '<span class="currency">' + row.currency + '</span>';
}

// Fetch balances
async function fetchBalance() {
  var json = {};
  try { json = await (await fetch('/api/balance')).json(); } catch(e) {}
  BALANCES.forEach(function(row) {
    var raw = json[row.field];
    showBalance(row, raw === undefined || raw === 'unknown' ? '—' : Number(raw || 0).toFixed(row.decimals));
  });
}
fetchBalance();
setInterval(fetchBalance, 15000);

</script>
</body>
</html>"
`;

